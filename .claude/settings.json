{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Bash(git branch *)",
      "Bash(git switch -c *)",
      "Bash(git switch --create *)",
      "Bash(git switch --orphan *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git checkout --orphan *)",
      "Bash(git worktree add *)",
      "Agent(isolation:worktree)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(application-prod*)"
    ]
  }
}
